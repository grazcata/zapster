<?xml version="1.0" encoding="utf-8"?>
<!--
  The Bravia IP Control API is plain HTTP. Cleartext is permitted app-wide
  because the config format cannot express "private IP ranges only"; the app
  itself only ever builds URLs from the LAN address entered in Settings.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.1.66</domain>
        <domain includeSubdomains="true">192.168.1.7</domain>
        <domain includeSubdomains="true">192.168.1.10</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
